# Copy to backend/.env for local development
DATABASE_URL=postgresql+asyncpg://cogniflow:devpassword@localhost:5432/cogniflow
MONGO_URL=mongodb://cogniflow:devpassword@localhost:27017
MONGO_DB=cogniflow
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-prod-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=1440

# LLM providers (get free keys at openrouter.ai and console.groq.com)
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Knowledge / RAG (defaults are fine for local dev)
STORAGE_DIR=storage
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_UPLOAD_MB=5
CHAT_REAPER_ENABLED=true
CHAT_REAPER_INTERVAL_SECONDS=60
CHAT_REAPER_STUCK_SECONDS=60
MCP_TIMEOUT_SECONDS=30
MCP_MAX_RESULT_BYTES=262144
